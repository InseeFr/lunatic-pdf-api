{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "auto",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ],
    "automerge": false,
    "labels": [
      "lockfile"
    ]
  },
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "description": "Lunatic : mises à jour minor/patch groupées",
      "matchFileNames": [
        "package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "/^@inseefr\\/lunatic/"
      ],
      "groupName": "lunatic",
      "groupSlug": "lunatic",
      "labels": [
        "dependencies",
        "lunatic"
      ]
    },
    {
      "description": "Dependencies : minor/patch groupées (hors lunatic)",
      "matchFileNames": [
        "package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "excludePackageNames": [
        "/^@inseefr\\/lunatic/"
      ],
      "groupName": "dependencies minor and patch updates",
      "groupSlug": "minor-patch",
      "labels": [
        "dependencies"
      ]
    },
    {
      "description": "DevDependencies : minor/patch groupées",
      "matchFileNames": [
        "package.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "devDependencies minor and patch updates",
      "groupSlug": "dev-minor-patch",
      "labels": [
        "devDependencies"
      ]
    }
  ]
}